{
  "manifest_version": 3,
  "name": "Narciso · Chrome local",
  "version": "0.2.2",
  "description": "Búsqueda, lectura y pasos de formularios revisados por el propietario para Narciso local.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Narciso: reconectar navegador"
  },
  "incognito": "not_allowed"
}
