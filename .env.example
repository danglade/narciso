# Owner's sending number, NOT the assistant's Photon number (E.164).
NARCISO_OWNER_PHONE=+12025550123
NARCISO_GOOGLE_EMAIL=you@example.com
NARCISO_TIMEZONE=America/New_York
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional local speech vocabulary: names that are often misheard.
NARCISO_SPEECH_VOCABULARY=Narciso.
NARCISO_SPEECH_FALLBACK=es
# Save a Google OAuth Desktop app client JSON to
# ~/.local/share/narciso/data/google-client.json.
# Run npm run google:login; tokens stay in that private data directory.
